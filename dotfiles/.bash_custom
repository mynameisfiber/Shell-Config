source ~/.profile

export PATH="/usr/local/bin:$PATH"

# VI mode!
set -o vi
export EDITOR="vim"

for script in ~/.bash_scripts/*;
do
    if [[ -r "$script" && -f "$script" ]] && file "$script" | grep -q "text"; then
        source "$script"
    fi
done

for script in ~/.bash_motd/*;
do
    if [[ -r "$script" && -f "$script" ]] && file "$script" | grep -q "text"; then
        source "$script"
    fi
done

