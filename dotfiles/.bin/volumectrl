#!/bin/bash

VOLUME_BOX=${VOLUME_BOX:-"\u25a0"}
OVERVOL_BOX=${OVERVOL_BOX:-"\u25cf"}
EMPTY_BOX=${EMPTY_BOX:-"\u25a1"}
MUTE_BOX=${MUTE_BOX:-"\u25a8"}

action=$1
num_boxes=${2:-10}

function repeat() {
    eval printf -- '$1%.s' {1..$2}
}

if [[ "$action" != "status" ]]; then
    if [[ "$action" == "toggle" ]]; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    elif [ ! -z "$action" ]; then
        # convert pulsemixer-style delta (+5/-5) to wpctl style (5%+/5%-)
        sign="${action:0:1}"
        num="${action:1}"
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "${num}%${sign}"
    fi
fi

IS_MUTE=$( wpctl get-volume @DEFAULT_AUDIO_SINK@ | grep -c MUTED )
VOLUME=$( wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}' )

if [ "$IS_MUTE" -eq "1" ]; then
    CHARS="▨□◫"
else
    CHARS="■□◧"
fi

echo -ne "$VOLUME%"
progress --characters="$CHARS" --progress=$VOLUME --width=20
